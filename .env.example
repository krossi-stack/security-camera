# Copy this file to .env and uncomment/edit values as needed.
# All settings have sensible defaults in config.py.

# --- Camera ---
# CAMERA_RTSP_URL=rtsp://admin:9999@192.168.100.150:554/stream/main
# CAMERA_FPS=15

# --- Web Server ---
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# --- Display ---
# DISPLAY_WIDTH=1280
# DISPLAY_HEIGHT=720

# --- Detection ---
# YOLO_MODEL=yolov8n.pt
# DETECTION_CONFIDENCE=0.45
# DETECT_EVERY_N_FRAMES=3

# --- Event Recording ---
# EVENT_DIR=logs/events
# EVENT_PRE_ROLL=5
# EVENT_POST_ROLL=10
# EVENT_MAX_DAYS=30
# EVENT_CONFIDENCE=0.75
# EVENT_SUSTAIN_SECONDS=1.0

# --- Encoding ---
# auto = libx264 on x86, h264_nvmpi on Jetson
# FFMPEG_ENCODER=auto

# --- HLS ---
# HLS_DIR=logs/hls
# HLS_SEGMENT_DURATION=1
# HLS_PLAYLIST_SIZE=3

# --- Smart Plug / Actions ---
# SMART_PLUG_IP=192.168.1.150
# LIGHT_ON_DURATION=120
# ACTION_COOLDOWN=30
# ALERT_START_HOUR=23
# ALERT_END_HOUR=6

# --- MJPEG (standalone server.py only) ---
# MJPEG_QUALITY=80
